{
  "manifest_version": 3,
  "name": "Medya Algılayıcı (geliştirici aracı)",
  "version": "0.1.0",
  "description": "Gezindiğiniz sekmedeki gerçek ağ isteklerinden video/resim/HLS adreslerini yakalar; indirmeden önce kalite/format seçtirir. Yalnızca kendi tarayıcı sekmeleriniz için çalışır.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["webRequest", "webNavigation", "downloads", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "minimum_chrome_version": "116"
}
